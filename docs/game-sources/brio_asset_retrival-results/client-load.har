          "content": {
            "size": 5158,
            "mimeType": "text/html",
            "text": "<!doctype html>\n<html>\n\n<head>\n    <meta name=\"ad.size\" content=\"width=300,height=250\">\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\n    <title></title>\n\n    <link href=\"main.css\" rel=\"stylesheet\" type=\"text/css\">\n\n    <script type=\"text/javascript\">var clickTag = \"https://www.google.com\";</script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/latest/TweenMax.min.js\" defer></script>\n    <script type=\"text/javascript\" src=\"main.js\" defer></script>\n</head>\n\n<body onload=\"init()\">\n    <a href=\"javascript:void(0);\" onClick=\"window.open(clickTag);\">\n        <div id=\"container\">\n            <div id=\"content\">\n                <div id=\"rolloverCatch\"></div>\n                <div id=\"cover\"></div>\n                <div id=\"logo\"><img src=\"images/logo.png\"></div>\n                <div id=\"cta\"><img src=\"images/cta.png\"></div>\n                <div id=\"txt_1a\" class=\"txt txt_1\"><img src=\"images/txt-1a.png\"></div>\n                <div id=\"txt_2a\" class=\"txt txt_2\"><img src=\"images/txt-2a.png\"></div>\n                <div id=\"txt_3a\" class=\"txt txt_3\"><img src=\"images/txt-3a.png\"></div>\n                <div id=\"txt_4a\" class=\"txt txt_4\"><img src=\"images/txt-4a.png\"></div>\n                <div id=\"gradient_1\" class=\"gradient\"></div>\n                <div id=\"gradient_2\" class=\"gradient\"></div>\n\n                <div id=\"laptop_wrapper\">\n                    <div id=\"laptop\"><img src=\"images/laptop.png\"></div>\n                    <div id=\"screen\">\n                        <div id=\"title_wrapper\">\n                            <div id=\"title_bg\"></div>\n                            <div id=\"title\"><img src=\"images/title.png\" alt=\"\"></div>\n                        </div>\n                        <div id=\"panel_l\">\n                            <div id=\"panel_l_header\">\n                                <div id=\"header_l\">\n                                    <img id=\"header_l_control\" src=\"images/header-l-control.png\">\n                                </div>\n                                <div id=\"header_r\">\n                                    <img id=\"header_r_btn\" src=\"images/header-r-btn.png\">\n                                    <img id=\"header_r_line\" src=\"images/header-r-line.png\">        \n                                    <img id=\"header_r_control\" src=\"images/header-r-control.png\">\n                                </div>\n                            </div>\n                            <div id=\"panel_l_body\">\n                                <div id=\"panel_l_1\"><img src=\"images/panel-l-1.png\"></div>\n                                <div id=\"panel_l_2\"><img class=\"x1\" src=\"images/panel-l-2.png\"></div>\n                                <div id=\"panel_l_3\"><div class=\"shadow\"></div><img src=\"images/panel-l-3.png\"><span></span></div>\n                                <div id=\"panel_l_4\"><img class=\"x1\" src=\"images/panel-l-4.png\"></div>\n                            </div>\n                            <div id=\"panel_l_0\"><img class=\"x1\" src=\"images/panel-l-0.png\"></div>\n                        </div>\n                        <div id=\"panel_r_wrapper\">\n                            <div id=\"panel_r\"><img src=\"images/panel-r.png\"></div>\n                            <div id=\"panel_r_btn\"><img src=\"images/panel-r-btn.png\"></div>\n                            <div id=\"panel_r_0\"><img class=\"x1\" src=\"images/panel-r-0.png\"></div>\n                        </div>\n                        <div id=\"overlay\"></div>\n                    </div>\n                </div>\n                <div id=\"doc_wrapper\">\n                    <div id=\"doc_3\" class=\"doc\"><img class=\"x1\" src=\"images/doc-3.png\"></div>\n                    <div id=\"doc_2\" class=\"doc\"><img class=\"x1\" src=\"images/doc-2.png\"></div>\n                    <div id=\"doc_1\" class=\"doc\"><img class=\"x1\" src=\"images/doc-1.png\"></div>\n                </div>\n                <!-- <div id=\"ui_1\"><img src=\"images/ui-1.png\"></div> -->\n                <div id=\"ui_2\"><span></span><img src=\"images/ui-2.png\"></div>\n                <div id=\"ui_3\">\n                    <div id=\"ui_3a\"><img src=\"images/ui-3a.png\"></div>\n                    <div id=\"ui_3b\"><img src=\"images/ui-3b.png\"></div>\n                    <div id=\"ui_3_line_1\" class=\"mask\"></div>\n                    <div id=\"ui_3_line_2\" class=\"mask\"><span></span></div>\n                    <div id=\"ui_3c\"><img src=\"images/ui-3c.png\"></div>\n                </div>\n                <div id=\"ui_4\"><img src=\"images/ui-4.png\"></div>\n                <div id=\"ui_5\">\n                    <div id=\"ui_5b\"><img src=\"images/ui-5b.png\"></div>\n                    <div id=\"ui_5c\"><img src=\"images/ui-5c.png\"></div>\n                    <div id=\"ui_5d\"><img src=\"images/ui-5d.png\"></div>\n                </div>\n                <div id=\"cursor\"><span></span><img src=\"images/cursor.png\"></div>\n                <div class=\"star\" id=\"star_1\"><img src=\"images/star-1.png\"></div>\n                <div class=\"star\" id=\"star_2\"><img src=\"images/star-2.png\"></div>\n            </div>\n        </div>\n    </a>\n</body>\n\n</html>"
